#!/bin/sh
#
# Ammo Unify - Gradle wrapper launcher (POSIX)
#
# Requires JDK 21. Uses JAVA_HOME when set, otherwise falls back to java on PATH.
#

APP_HOME=$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd -P)

if [ -n "$JAVA_HOME" ]; then
  JAVA_EXE="$JAVA_HOME/bin/java"
else
  JAVA_EXE=java
fi

exec "$JAVA_EXE" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
